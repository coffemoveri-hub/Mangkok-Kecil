# .gitignore - File yang tidak boleh di-upload ke GitHub
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
.output/
.astro/

# Environment variables - JANGAN PERNAH commit .env!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
