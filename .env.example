# File ini berisi variabel lingkungan untuk MangkokKecil
# JANGAN commit file .env yang sesungguhnya ke GitHub!
# Salin file ini menjadi .env dan isi nilai-nilainya

# ============================================================
# NOTION API CREDENTIALS
# Cara mendapatkannya: Baca README.md bagian Setup Notion CMS
# ============================================================

# Token API Notion kamu (dimulai dengan "secret_...")
NOTION_TOKEN=

# ID Database Notion yang berisi artikel blog kamu
NOTION_DATABASE_ID=
